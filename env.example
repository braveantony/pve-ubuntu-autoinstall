# Copy to .env (git-ignored, chmod 600) and fill in.
PVE_ENDPOINT=https://192.168.11.201:8006
PVE_NODE=node5
# Printed by scripts/pve-access.sh ("full-tokenid" and "value").
PVE_TOKEN_ID='automation@pve!iac'
PVE_TOKEN_SECRET=''
# VMID of the template: built by scripts/build-template.sh, cloned by
# scripts/tofu.sh. Must not be in use by any other VM or container.
TEMPLATE_VMID=605
# SSH login on the PVE node, root or a user with passwordless sudo. Used only
# by scripts/verify.sh and scripts/vm-screenshot.sh.
PVE_SSH=root@192.168.11.201
# Public key authorised on every VM's account (default: ~/.ssh/id_rsa.pub).
#SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# Container image with Packer, OpenTofu and their Proxmox plugins. Leave it
# unset to use the released image the scripts are pinned to; set it when you
# built your own from the Containerfile.
# TOOLS_IMAGE=ghcr.io/braveantony/pve-ubuntu-autoinstall:dev
