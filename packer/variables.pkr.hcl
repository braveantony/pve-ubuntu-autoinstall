# --- Proxmox connection (from .env, passed in as PKR_VAR_*) -------------------
variable "pve_endpoint" {
  type        = string
  description = "PVE API base URL, for example https://192.168.11.201:8006"
}

variable "pve_node" {
  type = string
}

variable "pve_token_id" {
  type        = string
  description = "user@realm!tokenid"
}

variable "pve_token_secret" {
  type      = string
  sensitive = true
}

# --- Template -----------------------------------------------------------------
variable "template_vmid" {
  type        = number
  default     = 605
  description = "Do not edit here: scripts/build-template.sh always overrides this with TEMPLATE_VMID from .env."
}

variable "template_name" {
  type    = string
  default = "ub2604-ci-temp"
}

variable "cores" {
  type    = number
  default = 4
}

variable "memory" {
  type    = number
  default = 8192
}

variable "disk_size" {
  type        = string
  default     = "50G"
  description = "Template disk size. Clones can grow it but never shrink it."
}

variable "vm_storage" {
  type    = string
  default = "vmdata"
}

variable "bridge" {
  type    = string
  default = "vmbr1"
}

# --- Install media ------------------------------------------------------------
variable "iso_file" {
  type    = string
  default = "local:iso/ubuntu-26.04-live-server-amd64.iso"
}

variable "iso_storage" {
  type        = string
  default     = "local"
  description = "Storage the generated autoinstall seed ISO is uploaded to."
}

variable "apt_mirror" {
  type    = string
  default = "http://tw.archive.ubuntu.com/ubuntu/"
}

variable "boot_wait" {
  type        = string
  default     = "8s"
  description = "Delay between power-on and typing into the GRUB menu. The ISO's menu waits 30s, so anything from when the menu appears up to ~25s works."
}

# --- Build-time only: gone from the finished template -------------------------
variable "build_ip_cidr" {
  type    = string
  default = "192.168.11.66/24"
}

variable "build_gateway" {
  type    = string
  default = "192.168.11.254"
}

variable "build_dns" {
  type    = string
  default = "192.168.11.2"
}

variable "build_username" {
  type    = string
  default = "packer"
}

variable "build_password" {
  type        = string
  sensitive   = true
  description = "Random per build, generated by scripts/build-template.sh."
}

variable "build_password_hash" {
  type        = string
  sensitive   = true
  description = "SHA-512 crypt hash of build_password."
}
