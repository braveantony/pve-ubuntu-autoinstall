# Values come from three places, none of which is this file:
#   overlays/<name>/env                   -> pve_*, template_vmid
#   overlays/<name>/site.hcl           -> vm_storage, iso_storage, bridge, gateway, dns_servers
#   overlays/<name>/template.pkrvars.hcl  -> everything under "Template"
# The defaults below are only fallbacks for the optional settings.

# --- Proxmox connection (overlay env, passed in as PKR_VAR_*) ----------------
variable "pve_endpoint" {
  type        = string
  description = "PVE API base URL, for example https://192.168.11.201:8006"
}

variable "pve_node" {
  type = string
}

variable "pve_token_id" {
  type        = string
  description = "user@realm!tokenid"
}

variable "pve_token_secret" {
  type      = string
  sensitive = true
}

variable "template_vmid" {
  type        = number
  description = "TEMPLATE_VMID in the overlay env."
}

# --- Site (overlay site.hcl, shared with OpenTofu) -------------------------
variable "vm_storage" {
  type        = string
  description = "Storage for VM disks."
}

variable "iso_storage" {
  type        = string
  description = "Storage the generated autoinstall seed ISO is uploaded to."
}

variable "bridge" {
  type = string
}

variable "gateway" {
  type = string
}

variable "dns_servers" {
  type = list(string)
}

# --- Template (overlay template.pkrvars.hcl) ----------------------------------
variable "iso_file" {
  type        = string
  description = "Installer ISO as PVE names it, for example local:iso/ubuntu-26.04-live-server-amd64.iso"
}

variable "build_ip_cidr" {
  type        = string
  description = "Address the VM uses during the build only, for example 192.168.11.66/24."
}

variable "template_name" {
  type    = string
  default = "ub2604-ci-temp"
}

variable "cores" {
  type    = number
  default = 4
}

variable "memory" {
  type    = number
  default = 8192
}

variable "disk_size" {
  type        = string
  default     = "50G"
  description = "Template disk size. Clones can grow it but never shrink it."
}

variable "apt_mirror" {
  type    = string
  default = "http://archive.ubuntu.com/ubuntu/"
}

variable "boot_wait" {
  type        = string
  default     = "8s"
  description = "Delay between power-on and typing into the GRUB menu. The ISO's menu waits 30s, so anything from when the menu appears up to ~25s works."
}

variable "user_data_template" {
  type        = string
  default     = ""
  description = "Set by scripts/build-template.sh when the overlay has its own user-data.pkrtpl.yaml."
}

# --- Build-time only: gone from the finished template -------------------------
variable "build_username" {
  type    = string
  default = "packer"
}

variable "build_password" {
  type        = string
  sensitive   = true
  description = "Random per build, generated by scripts/build-template.sh."
}

variable "build_password_hash" {
  type        = string
  sensitive   = true
  description = "SHA-512 crypt hash of build_password."
}
