# Overlays other than the example stay local by default. To version one of
# your own, add a line "!/overlays/<name>/" below; the secret and state files
# listed after it are still ignored.
/overlays/*
!/overlays/example/

# Secrets and local state: never commit
overlays/*/env
overlays/*/secrets.tfvars
overlays/*/*.tfstate
overlays/*/*.tfstate.*
overlays/*/.terraform/
overlays/*/.terraform.tfstate.lock.info

# Local caches (downloaded docs, build keys)
.cache/
